@model WebGestion.Models.Routing

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Routing</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Numeracion" class="control-label"></label>
                <input asp-for="Numeracion" class="form-control" />
                <span asp-validation-for="Numeracion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ruta" class="control-label"></label>
                <input asp-for="Ruta" class="form-control" />
                <span asp-validation-for="Ruta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
